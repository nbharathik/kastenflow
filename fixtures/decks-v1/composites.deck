            {
              "role": "user",
              "text": "Do I need an umbrella in Oslo today?"
            },
            {
              "role": "toolCall",
              "text": "get_weather(city=\"Oslo\", day=\"today\")"
            },
            {
              "role": "toolResult",
              "text": "{\"temp_c\": 4, \"sky\": \"rain\", \"chance\": 0.9}"
            },
            {
              "role": "assistant",
              "text": "Yes: it is 4 degrees with a 90% chance of rain."
            }
