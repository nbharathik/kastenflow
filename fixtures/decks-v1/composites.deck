        {
          "code": "from dataclasses import dataclass\n\n@dataclass\nclass Card:\n    title: str\n    body: str = \"\"\n\n    def shout(self) -> str:\n        # loud, on purpose\n        return f\"{self.title.upper()}!\" + str(42)\n",
          "h": 344,
          "id": "code-dark",
          "language": "python",
          "type": "code",
          "w": 832,
          "x": 64,
          "y": 148
        }
      ],
      "id": "s-4lpxqanm",
      "layout": "title-only"
    },
    {
      "elements": [
        {
          "id": "e-14pfw3mf",
          "placeholder": "title",
          "text": {
            "paragraphs": [
              {
                "runs": [
                  {
                    "t": "Code, light, with line numbers"
                  }
                ]
              }
            ]
          },
          "type": "text"
        },
        {
          "code": "use std::collections::HashMap;\n\nfn count(words: &[&str]) -> HashMap<String, usize> {\n    let mut seen = HashMap::new();\n    for w in words {\n        *seen.entry((*w).to_owned()).or_insert(0) += 1;\n    }\n    seen\n}",
          "firstLine": 41,
          "h": 344,
          "id": "code-light",
          "language": "rust",
          "lineNumbers": true,
          "theme": "light",
          "type": "code",
          "w": 832,
          "x": 64,
          "y": 148
        }
      ],
      "id": "s-gyq0pekz",
      "layout": "title-only"
    },
    {
      "elements": [
        {
          "id": "e-f5eklfck",
          "placeholder": "title",
          "text": {
            "paragraphs": [
              {
                "runs": [
                  {
                    "t": "A walkthrough of code"
                  }
                ]
              }
            ]
          },
          "type": "text"
        },
        {
          "code": "interface Tool {\n  name: string;\n  run(input: string): Promise<string>;\n}\n\nasync function step(tools: Tool[], call: string) {\n  const tool = tools.find((t) => call.startsWith(t.name));\n  return tool ? await tool.run(call) : \"unknown tool\";\n}",
          "focus": [
            "1-4",
            "6",
            "7-8",
            "9"
          ],
          "h": 344,
          "id": "code-focus",
          "language": "typescript",
          "lineNumbers": true,
          "type": "code",
          "w": 832,
          "x": 64,
          "y": 148
        },
        {
