BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Kasten fixtures//All-day events//EN
X-WR-CALNAME:All-day events
BEGIN:VEVENT
UID:single@allday.example
SUMMARY:Single day
DTSTART;VALUE=DATE:20261012
DTEND;VALUE=DATE:20261013
END:VEVENT
BEGIN:VEVENT
UID:three@allday.example
SUMMARY:Three days
DTSTART;VALUE=DATE:20261020
DTEND;VALUE=DATE:20261023
END:VEVENT
BEGIN:VEVENT
UID:no-end@allday.example
SUMMARY:No end given
DTSTART;VALUE=DATE:20261105
END:VEVENT
BEGIN:VEVENT
UID:duration@allday.example
SUMMARY:Two days by duration
DTSTART;VALUE=DATE:20261110
DURATION:P2D
END:VEVENT
BEGIN:VEVENT
UID:zero@allday.example
SUMMARY:Zero length
DTSTART;VALUE=DATE:20261115
DTEND;VALUE=DATE:20261115
END:VEVENT
BEGIN:VEVENT
UID:weekly@allday.example
SUMMARY:Weekly all day
DTSTART;VALUE=DATE:20261001
DTEND;VALUE=DATE:20261002
RRULE:FREQ=WEEKLY;COUNT=5
EXDATE;VALUE=DATE:20261015
END:VEVENT
BEGIN:VEVENT
UID:birthday@allday.example
SUMMARY:Birthday
DTSTART;VALUE=DATE:20100301
DTEND;VALUE=DATE:20100302
RRULE:FREQ=YEARLY
END:VEVENT
BEGIN:VEVENT
UID:month-end@allday.example
SUMMARY:Over the month end
DTSTART;VALUE=DATE:20261030
DTEND;VALUE=DATE:20261103
END:VEVENT
BEGIN:VEVENT
UID:dinner@allday.example
SUMMARY:Dinner until midnight
DTSTART:20261120T200000Z
DTEND:20261121T000000Z
END:VEVENT
BEGIN:VEVENT
UID:until-date@allday.example
SUMMARY:Daily until a date
DTSTART;VALUE=DATE:20261201
DTEND;VALUE=DATE:20261202
RRULE:FREQ=DAILY;UNTIL=20261203
END:VEVENT
END:VCALENDAR
