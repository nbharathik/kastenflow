{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KastenFlow",
  "mainBinaryName": "kasten-app",
  "identifier": "io.github.nbharathik.kasten",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KastenFlow",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "frame-src": "http: https: http://diagrams.localhost diagrams://localhost",
        "media-src": "'self' blob: asset: http://asset.localhost",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "nsis", "msi", "app", "dmg"],
    "category": "Productivity",
    "homepage": "https://nbharathik.github.io/kastenflow/",
    "publisher": "The KastenFlow contributors",
    "copyright": "Copyright (c) 2026 nbharathik and the KastenFlow contributors",
    "shortDescription": "Notes, whiteboards and a journal, as plain Markdown you own",
    "longDescription": "KastenFlow keeps pages, a journal, whiteboards and tag databases as plain Markdown files in a folder you choose. Every change is kept in git history, and AI agents work beside you within guardrails.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
