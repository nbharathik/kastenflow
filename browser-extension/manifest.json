{
  "manifest_version": 3,
  "name": "Send to KastenFlow",
  "version": "1.2.0",
  "description": "Send the page you are on, a selection, a link or a picture to KastenFlow, the notes app on this computer.",
  "minimum_chrome_version": "103",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "action": {
    "default_title": "Send to KastenFlow",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/32.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "dist/background-main.js", "type": "module" },
  "icons": { "16": "icons/32.png", "32": "icons/32.png", "48": "icons/64.png", "128": "icons/128.png" }
}
