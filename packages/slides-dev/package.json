{
  "name": "@kasten-slides/dev",
  "version": "0.1.0",
  "private": true,
  "description": "The KastenFlow Slides editor as a web page: what `slides dev` serves, and the page the editor's visual checks open",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "node ../../scripts/build-wasm.mjs --if-stale",
    "test": "vitest run"
  },
  "dependencies": {
    "@kasten-slides/react": "workspace:*",
    "@kasten-slides/wasm": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
